# Copy to .env.local for local dev, or to .env.production on the VPS.
# Every service ID / host the storefront uses is configured here —
# nothing is hardcoded that you might need to change.
#
# NOTE: NEXT_PUBLIC_* vars are baked in at BUILD time. After editing them
# on the server, rebuild + restart: npm run build && pm2 restart (or ./server.sh).

# Public base URL of the WordPress + WooCommerce backend.
# Since the headless cutover (2026-10-02) the backend lives on edenapi;
# eden.indemos.com is the Next.js storefront itself — never point this there.
WC_STORE_URL=https://edenapi.indemos.com

# Canonical public URL of the storefront itself. Used by /sitemap.xml and
# /robots.txt (the URLs Google / Facebook / Pinterest should index).
NEXT_PUBLIC_SITE_URL=https://eden.indemos.com

# Google Tag Manager container, carried over from the old WordPress site.
# GA4 (measurement G-E32XHLM3HS) stays configured inside the container,
# exactly as on WordPress — this only selects which container loads.
NEXT_PUBLIC_GTM_ID=GTM-PS65QF25

# Google Places API key for address autocomplete at /checkout.
# Get one at Google Cloud Console → APIs & Services → Places API (New).
# Restrict by HTTP referrer to your domain. Bakes at build time.
NEXT_PUBLIC_GOOGLE_PLACES_KEY=

# Stripe publishable key (pk_live_... / pk_test_...) — enables card payments
# at /checkout via the store's Stripe gateway. Find it in the Stripe Dashboard
# under Developers → API keys. Safe to expose (it's public by design).
# If omitted, the card option is hidden and PayPal remains available.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# WooCommerce REST API keys (ck_... / cs_...) — server-side only, never public.
# Powers the /account editors (orders, addresses, account details).
# Create in WP admin: WooCommerce → Settings → Advanced → REST API → Add key
# (user: an admin, permissions: Read/Write). The storefront only ever
# requests the signed-in customer's own data.
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Self-contained password reset (no WordPress plugins).
# The storefront generates a signed reset token and emails it directly —
# WP only stores the new password via the REST API.
# PASSWORD_RESET_SECRET: random 32+ char string (e.g. openssl rand -hex 32).
# WP_ADMIN_USER / WP_APP_PASSWORD: WP admin username + Application Password
#   (Users → Profile → Application Passwords). Used to look up the user by
#   email and set the new password via /wp-json/wp/v2/users.
PASSWORD_RESET_SECRET=
WP_ADMIN_USER=
WP_APP_PASSWORD=

# JWT Authentication for WP REST API plugin (user sessions).
# Must match the JWT_AUTH_SECRET_KEY defined in wp-config.php on the WP backend.
# The storefront verifies JWT signatures locally with this secret.
JWT_AUTH_SECRET_KEY=

# Outgoing email for password resets (and the contact form).
# Option A — Resend (simplest): just set RESEND_API_KEY.
# Option B — SMTP: set SMTP_HOST/PORT/USER/PASS (nodemailer).
# EMAIL_FROM must be a verified sender on the chosen service.
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
