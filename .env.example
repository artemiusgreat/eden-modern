# Copy to .env.local and fill in.
# Public base URL of the WordPress + WooCommerce backend.
WOO_STORE_URL=https://eden.indemos.com

# Stripe publishable key (pk_live_... / pk_test_...) — enables card payments
# at /checkout via the store's Stripe gateway. Find it in the Stripe Dashboard
# under Developers → API keys. Safe to expose (it's public by design).
# If omitted, the card option is hidden and PayPal remains available.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
